{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "samobile",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  // Content database (articles, translations, audit log). Create it once with:
  //   npx wrangler d1 create samobile
  // then paste the returned id below. See docs/cms-admin.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "samobile",
      "database_id": "4352f184-9ea0-480f-9eb6-46b7fae17fd9",
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare Access settings for /admin (not secrets). Leave empty until Access is created;
  // while empty the admin area stays locked for everyone except localhost with .dev.vars.
  "vars": {
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "ADMIN_EMAILS": ""
  }
}
